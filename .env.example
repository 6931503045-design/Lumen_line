PORT=3000
NODE_ENV=development
TZ=Asia/Bangkok

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini
AI_ENABLED=true
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_GLOBAL=
AI_TIMEOUT_MS=8000

LIFF_ID=

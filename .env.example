# ไฟล์นี้ทำหน้าที่อะไร: แม่แบบของค่าตั้งค่าทั้งหมด (LINE + Supabase + Gemini + เว็บ)
# ใครรับผิดชอบ: ① Bot Core / ② Database / ③ AI / ④ Frontend
#
# ⚠️ ไฟล์นี้เป็นแม่แบบ ค่าว่างทั้งหมดโดยตั้งใจ ห้ามใส่ค่าจริงลงไฟล์นี้
# ตอน deploy ให้ใส่ค่าในหน้า dashboard ของ host (Render/Railway) ไม่ต้องอัปโหลดไฟล์
# ตอนรันในเครื่อง ให้ก๊อปไฟล์นี้เป็น .env แล้วเติมค่า (.env ถูก .gitignore ไว้แล้ว)
# ดูขั้นตอนเต็มที่ docs/DEPLOY.md
# ⚖️ กฎเหล็ก G4, G5, G6

PORT=3000
NODE_ENV=development
TZ=Asia/Bangkok

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini
AI_ENABLED=true
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_GLOBAL=
AI_TIMEOUT_MS=8000

# URL ที่เปิดเว็บนี้ ใช้ประกอบ redirect_uri ของ LINE Login (ไม่ต้องมี / ปิดท้าย)
APP_BASE_URL=http://localhost:3000
# กุญแจเซ็น session cookie — สร้างด้วย: openssl rand -hex 32
SESSION_SECRET=

GMAIL_USER=
GMAIL_APP_PASSWORD=

CRON_SECRET=
